{
  "name": "buchikui",
  "version": "1.0.0",
  "private": true,
  "description": "不吃亏：消费经历调研与真实案例资料库。",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "build": "node scripts/build-authority.mjs && node scripts/build-content-db.mjs && node scripts/build-portrait-assets.mjs && node scripts/bundle-cases.mjs && node scripts/build-content-index.mjs && node scripts/build-sitemap.mjs",
    "db:build": "node scripts/build-content-db.mjs",
    "db:inspect": "node scripts/inspect-content-db.mjs",
    "build:authority": "node scripts/build-authority.mjs",
    "build:cases": "npm run build",
    "build:index": "node scripts/build-content-index.mjs",
    "build:site": "npm run build && node scripts/prepare-site.mjs _site",
    "check": "node scripts/check-corpus.mjs && node scripts/check-frontend-contract.mjs",
    "check:corpus": "node scripts/check-corpus.mjs",
    "check:frontend": "node scripts/check-frontend-contract.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "orphans": "node scripts/check-corpus.mjs --orphans",
    "verify": "npm run build && npm run test && npm run check",
    "site": "npm run build:site && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "survey:inspect": "node scripts/inspect-survey.mjs"
  }
}
